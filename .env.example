# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop?schema=public"

# NextAuth (Auth.js v5)
AUTH_SECRET="brightloop-super-secret-key-production-ready-2026-secure"
AUTH_TRUST_HOST=true

# Backward compatibility with v4 / environment scripts
NEXTAUTH_SECRET="brightloop-super-secret-key-production-ready-2026-secure"
NEXTAUTH_URL="http://localhost:3000"
PORT=3000

